# Copy to ".env" and fill in your own values. NEVER commit a real .env.
# These are read by the example scripts in examples/ (and by your own code).
#
# Anaplan account credentials (basic auth -> bearer token).
ANAPLAN_EMAIL=you@example.com
ANAPLAN_PASSWORD=your-anaplan-password

# IDs of the workspace and model you want to work against. Discover these by
# running examples/list_models.py once you have valid credentials.
ANAPLAN_WORKSPACE_ID=your-workspace-id
ANAPLAN_MODEL_ID=your-model-id
